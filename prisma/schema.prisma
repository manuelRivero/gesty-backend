generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model business {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String
  description               String?
  timezone                  String                      @default("America/Argentina/Buenos_Aires")
  is_active                 Boolean                     @default(true)
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  openai_api_key            String?
  openai_model              String?                     @default("gpt-3.5-turbo")
  openai_active             Boolean?                    @default(true)
  whatsapp_phone_number     String?
  whatsapp_phone_id         String?
  whatsapp_access_token     String?
  ai_monthly_tokens_used    Int                         @default(0)
  ai_monthly_token_limit    Int                         @default(100000)
  ai_plan                   String                      @default("basic")
  ai_reset_at               DateTime                    @default(now()) @db.Timestamptz(6)
  ai_blocked                Boolean                     @default(false)
  currency_code             String?                     @db.Char(3)
  latitude                  Float?
  longitude                 Float?
  billing_mode              String?                     @default("subscription")
  slug                      String?                     @unique
  /// Rubro gastronómico para la vitrina global de Shopping (ver BUSINESS_CATEGORIES).
  category                  String?
  features                  Json?                       @default("{}")
  street_address            String?
  address_notes             String?
  image_url                 String?
  image_key                 String?
  currency                  currency?                   @relation(fields: [currency_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  business_config           business_config?
  business_coverage_zone    business_coverage_zone[]
  business_hours            business_hours[]
  business_payment_provider business_payment_provider[]
  business_user             business_user[]
  conversation              conversation[]
  customer                  customer[]
  draft_order               draft_order[]
  environment               environment[]
  menu_category             menu_category[]
  menu_item                 menu_item[]
  orders                    orders[]
  payment_intent            payment_intent[]
  payment_method_config     payment_method_config[]
  payment_proof             payment_proof[]
  promotion                 promotion[]
  reservation               reservation[]
  reservation_block         reservation_block[]
  reservation_config        reservation_config?
  reservation_slot          reservation_slot[]
  subscription              subscription?
  table                     table[]
  table_tab                 table_tab[]
  preparation_station       preparation_station[]
  tab_payment               tab_payment[]
  billable_charge           billable_charge[]
  conversation_note         conversation_note[]
  canned_reply              canned_reply[]
  storefront_order_push_subscription storefront_order_push_subscription[]
  checkout_attempt          checkout_attempt[]
  fiscal_configuration       fiscal_configuration?
  fiscal_invoice             fiscal_invoice[]
  invoicing_addon            invoicing_addon?
  invoicing_usage_period     invoicing_usage_period[]
}

model business_user {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String         @db.Uuid
  business_id     String?        @db.Uuid
  role            String
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  business        business?      @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_business")
  app_user        AppUser        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")
  user_session    user_session[]
  assigned_orders orders[]       @relation("OrderAssignedDelivery")
  assigned_conversations conversation[] @relation("ConversationAssignee")
  support_acked_conversations conversation[] @relation("ConversationSupportAck")
  conversation_notes conversation_note[]
  opened_table_tabs    table_tab[] @relation("TableTabOpenedBy")
  assigned_table_tabs  table_tab[] @relation("TableTabAssignedTo")
  requested_order_item_adjustments order_item_adjustment[] @relation("OrderItemAdjustmentRequestedBy")
  created_tab_payments tab_payment[] @relation("TabPaymentCreatedBy")

  @@unique([user_id, business_id], map: "unique_user_business")
}

model user_session {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String        @db.Uuid
  business_user_id String        @db.Uuid
  expires_at       DateTime      @db.Timestamptz(6)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  business_user    business_user @relation(fields: [business_user_id], references: [id], onDelete: Cascade)
  app_user         AppUser       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([business_user_id])
}

model conversation {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id             String                 @db.Uuid
  customer_id             String                 @unique(map: "conversation_open_customer_unique", where: raw("(status = 'open'::text)")) @db.Uuid
  channel                 String                 @default("whatsapp")
  status                  String                 @default("open")
  started_at              DateTime               @default(now()) @db.Timestamptz(6)
  last_message_at         DateTime               @default(now()) @db.Timestamptz(6)
  lastReferencedProductId String?                @map("last_referenced_product_id") @db.Uuid
  idle_reminder_sent_at   DateTime?              @db.Timestamptz(6)
  idle_closed_at          DateTime?              @db.Timestamptz(6)
  ai_sentiment            String?
  ai_sentiment_updated_at DateTime?              @db.Timestamptz(6)
  assigned_business_user_id String?              @db.Uuid
  assigned_at             DateTime?              @db.Timestamptz(6)
  support_requested_at    DateTime?              @db.Timestamptz(6)
  support_acked_at        DateTime?              @db.Timestamptz(6)
  support_acked_by_business_user_id String?      @db.Uuid
  business                business               @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer                customer               @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assigned_business_user  business_user?         @relation("ConversationAssignee", fields: [assigned_business_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  support_acked_by_business_user business_user?  @relation("ConversationSupportAck", fields: [support_acked_by_business_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  conversation_message    conversation_message[]
  conversation_state      conversation_state?
  conversation_note       conversation_note[]
  orders                  orders[]
  payment_proof           payment_proof[]
  reservation             reservation[]

  @@index([last_message_at], map: "idx_conversation_last_message_at", where: raw("(status = 'open'::text)"))
  @@index([business_id, assigned_business_user_id], map: "idx_conversation_assigned_open", where: raw("(status = 'open'::text)"))
  @@index([business_id, support_requested_at], map: "idx_conversation_support_pending", where: raw("(support_acked_at IS NULL)"))
}

model conversation_message {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id       String       @db.Uuid
  sender                String
  message               String
  is_ai_generated       Boolean      @default(false)
  created_at            DateTime     @default(now()) @db.Timestamptz(6)
  externalMessageId     String?      @unique
  ai_prompt_tokens      Int?
  ai_completion_tokens  Int?
  ai_total_tokens       Int?
  ai_estimated_cost_usd Decimal?     @db.Decimal(10, 6)
  whatsapp_message_id   String?      @unique
  sent_by_user_id       String?      @db.Uuid
  conversation          conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sent_by_user          AppUser?     @relation(fields: [sent_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model conversation_note {
  id                            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id               String        @db.Uuid
  business_id                   String        @db.Uuid
  body                          String
  created_by_business_user_id   String        @db.Uuid
  created_at                    DateTime      @default(now()) @db.Timestamptz(6)
  conversation                  conversation  @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  business                      business      @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_by_business_user      business_user @relation(fields: [created_by_business_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, created_at(sort: Desc)], map: "idx_conversation_note_conv_created")
}

model canned_reply {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id String   @db.Uuid
  title       String   @db.VarChar(120)
  body        String
  position    Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  business    business @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([business_id, position], map: "idx_canned_reply_business_position")
}

model conversation_state {
  conversation_id  String       @id @db.Uuid
  current_intent   String?
  is_human_handled Boolean      @default(false)
  updated_at       DateTime     @default(now()) @db.Timestamptz(6)
  metadata         Json?
  pending_action   String?
  mode             String       @default("GLOBAL")
  conversation     conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model currency {
  code            String            @id @db.Char(3)
  name            String
  symbol          String
  is_active       Boolean           @default(true)
  business        business[]
  customer        customer[]
  menu_item_price menu_item_price[]
  orders          orders[]
}

model customer {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id        String             @db.Uuid
  phone_number       String
  name               String?
  preferred_currency String?            @db.Char(3)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  conversation       conversation?
  business           business           @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  currency           currency?          @relation(fields: [preferred_currency], references: [code], onDelete: NoAction, onUpdate: NoAction)
  customer_address   customer_address[]
  orders             orders[]
  payment_proof      payment_proof[]
  reservation        reservation[]

  @@unique([business_id, phone_number])
}

model draft_order {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String?            @db.Uuid
  customer_phone   String
  status           String             @default("active")
  total_amount     Decimal            @default(0) @db.Decimal(10, 2)
  currency         String             @default("ARS")
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  expires_at       DateTime?          @db.Timestamptz(6)
  reminder_sent_at DateTime?          @db.Timestamptz(6)
  fulfillment_type FulfillmentType?
  payment_method   String?
  delivery_fee     Decimal?           @db.Decimal(10, 2)
  business         business?          @relation(fields: [business_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  draft_order_item draft_order_item[]
  payment_intent   payment_intent[]

  @@index([status, expires_at], map: "idx_draft_order_timeout")
}

model draft_order_item {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draft_order_id  String?      @db.Uuid
  product_id      String?      @db.Uuid
  quantity        Int
  unit_price      Decimal      @db.Decimal(10, 2)
  total_price     Decimal      @db.Decimal(10, 2)
  notes           String?
  list_price      Decimal?     @db.Decimal(10, 2)
  discount_amount Decimal?     @db.Decimal(10, 2)
  /// Variación elegida por el cliente (p. ej. "Roquefort"), congelada como texto.
  variation       String?
  draft_order     draft_order? @relation(fields: [draft_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  menu_item       menu_item?   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model menu_category {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id  String          @db.Uuid
  name         String
  description  String?
  position     Int             @default(0)
  is_active    Boolean         @default(true)
  created_at   DateTime        @default(now()) @db.Timestamptz(6)
  category_tag MenuCategoryTag @default(OTHER)
  business     business        @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu_item    menu_item[]

  @@index([business_id, category_tag])
}

model menu_item {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id           String                 @db.Uuid
  category_id           String                 @db.Uuid
  name                  String
  description           String?
  ingredients           String?
  preparation           String?
  is_available          Boolean                @default(true)
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  serves_people         Int?
  is_featured           Boolean                @default(false)
  ingredients_notes     String?
  image                 String?
  embedding             Unsupported("vector")?
  discount_type         String?                @db.VarChar(10)
  discount_value        Decimal?               @db.Decimal(10, 2)
  image_key             String?
  /// Lista de variaciones de nombre (p. ej. "Roquefort", "Napolitana"). `[]` ≡ `null`
  /// ≡ sin variaciones (Prisma no distingue NULL de [] en columnas array). Todas
  /// las variaciones comparten el mismo precio del platillo (D2).
  variations            String[]
  draft_order_item      draft_order_item[]
  business              business               @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu_category         menu_category          @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  menu_item_ai_metadata menu_item_ai_metadata?
  menu_item_price       menu_item_price[]
  order_item            order_item[]
  promotion_product     promotion_product[]
  menu_item_station     menu_item_station?

  @@index([embedding])
}

/// Promoción interpretada desde lenguaje natural (texto o audio del dueño) en el
/// panel admin. `offer` guarda el StructuredOffer V1 completo porque el contrato
/// todavía no está congelado; las columnas escalares son cache derivada para
/// filtrar y ordenar (ver PLAN-ACCION-PROMOCIONES-PERSISTENCIA.md, D1).
/// Nada la aplica a pedidos todavía: no hay motor de descuentos.
/// Promoción aplicada a una orden, congelada al crearla (D3).
/// `offer_snapshot` es obligatorio porque `updatePromotion` reemplaza el
/// `offer` de la promoción viva: sin snapshot, la historia financiera mutaría
/// cuando el dueño edita la promo meses después.
model order_promotion {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id        String     @db.Uuid
  /// FK informativa: la promo puede editarse o archivarse después.
  promotion_id    String?    @db.Uuid
  name_snapshot   String
  offer_snapshot  Json
  benefit_type    String
  /// order_discount | free_item | free_shipping
  applied_as      String
  discount_amount Decimal    @default(0) @db.Decimal(12, 2)
  saving_value    Decimal    @default(0) @db.Decimal(12, 2)
  evaluated_at    DateTime   @default(now()) @db.Timestamptz(6)
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  orders          orders     @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  promotion       promotion? @relation(fields: [promotion_id], references: [id], onUpdate: NoAction)

  @@index([order_id], map: "idx_order_promotion_order")
  @@index([promotion_id], map: "idx_order_promotion_promotion")
}

model promotion {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id  String              @db.Uuid
  name         String
  /// draft | active | paused | archived (TEXT, no enum — D11)
  status       String              @default("draft")
  offer        Json
  benefit_type String?
  starts_at    DateTime?           @db.Timestamptz(6)
  ends_at      DateTime?           @db.Timestamptz(6)
  /// 0=domingo … 6=sábado, igual que `Date.getDay()`
  days_of_week Int[]               @db.SmallInt
  time_from    String?
  time_to      String?
  /// text | audio. El audio nunca se persiste, solo su transcripción.
  source_type  String              @default("text")
  source_text  String?
  created_by   String?             @db.Uuid
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  updated_at   DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  orders       order_promotion[]
  business     business            @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products     promotion_product[]

  @@index([business_id, created_at(sort: Desc)], map: "idx_promotion_business_created")
  @@index([business_id, status], map: "idx_promotion_business_status")
}

/// Vínculo confirmado por el dueño entre un nombre que dijo ("papas fritas") y
/// un platillo real del menú. `source_text` queda congelado como texto para que
/// un renombre del catálogo no borre lo que se pidió originalmente (D2).
model promotion_product {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotion_id String    @db.Uuid
  menu_item_id String    @db.Uuid
  /// condition = producto que activa la promo; benefit = producto regalado
  role         String
  /// path dentro del offer, ej. offer.conditions[0].value.productName
  offer_path   String
  source_text  String
  quantity     Int?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  menu_item    menu_item @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  promotion    promotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([promotion_id, offer_path, menu_item_id], map: "uq_promotion_product_path_item")
  @@index([menu_item_id], map: "idx_promotion_product_menu_item")
  @@index([promotion_id], map: "idx_promotion_product_promotion")
}

model business_hours {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id String   @db.Uuid
  day_of_week Int
  opens_at    String
  closes_at   String
  is_closed   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  business    business @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([business_id, day_of_week])
}

model reservation_slot {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id    String    @db.Uuid
  day_of_week    Int
  start_time     DateTime  @db.Time(6)
  end_time       DateTime  @db.Time(6)
  capacity_limit Int?
  is_active      Boolean?  @default(true)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  business       business  @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_slot_business")
}

model menu_item_price {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menu_item_id  String    @db.Uuid
  currency_code String    @db.Char(3)
  amount        Decimal   @db.Decimal(12, 2)
  valid_from    DateTime  @default(now()) @db.Timestamptz(6)
  valid_to      DateTime? @db.Timestamptz(6)
  is_active     Boolean   @default(true)
  currency      currency  @relation(fields: [currency_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  menu_item     menu_item @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model order_item {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id        String    @db.Uuid
  menu_item_id    String    @db.Uuid
  quantity        Int       @default(1)
  unit_price      Decimal   @db.Decimal(12, 2)
  serves_people   Int?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  notes           String?
  list_price      Decimal?  @db.Decimal(12, 2)
  discount_amount Decimal?  @db.Decimal(12, 2)
  /// Variación elegida por el cliente, congelada como texto (D3).
  variation       String?
  menu_item       menu_item @relation(fields: [menu_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders          orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  kitchen_ticket_item kitchen_ticket_item?
  order_item_adjustment order_item_adjustment[]
  billable_charge_line billable_charge_line[]
}

model orders {
  id                        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id               String             @db.Uuid
  customer_id               String             @db.Uuid
  conversation_id           String?            @db.Uuid
  status                    OrderStatus        @default(draft)
  currency_code             String             @db.Char(3)
  total_amount              Decimal?           @db.Decimal(12, 2)
  created_at                DateTime           @default(now()) @db.Timestamptz(6)
  customer_address_id       String?            @db.Uuid
  delivery_address_snapshot Json?              @default("{}")
  payment_status            OrderPaymentStatus @default(unpaid)
  fulfillment_type          FulfillmentType?
  payment_method            String?
  delivery_fee              Decimal?           @db.Decimal(12, 2)
  payment_adjustment        Decimal?           @db.Decimal(12, 2)
  ambassador_public_code    String?
  ambassador_notified_at    DateTime?          @db.Timestamptz(6)
  ambassador_notify_result  Json?
  /// Descuento promocional congelado al crear la orden (D3). Lo consume el pricing.
  promotion_discount          Decimal?           @db.Decimal(12, 2)
  /// Repartidor asignado (membresía business_user con rol DELIVERY).
  assigned_delivery_user_id   String?            @db.Uuid
  /// Ronda de una cuenta de salón (Fase 3, POS_TECHNICAL_DESIGN.md §4.B). Nullable:
  /// nunca afecta delivery/take-away, que no tienen `table_tab`.
  table_tab_id                String?            @db.Uuid
  order_item                  order_item[]
  order_promotion             order_promotion[]
  assigned_delivery_user      business_user?     @relation("OrderAssignedDelivery", fields: [assigned_delivery_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  table_tab                   table_tab?         @relation(fields: [table_tab_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_table_tab")
  business                    business           @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversation              conversation?      @relation(fields: [conversation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currency                  currency           @relation(fields: [currency_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  customer_address          customer_address?  @relation(fields: [customer_address_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer                  customer           @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_intent            payment_intent[]
  payment_proof             payment_proof[]
  storefront_order_push_subscription storefront_order_push_subscription[]
  fiscal_invoice             fiscal_invoice[]
  kitchen_ticket             kitchen_ticket[]
  tab_payment_application    tab_payment_application[]

  @@index([customer_address_id], map: "idx_orders_customer_address")
  @@index([assigned_delivery_user_id], map: "idx_orders_assigned_delivery_user")
  @@index([table_tab_id], map: "idx_orders_table_tab")
  @@index([business_id], map: "idx_orders_ambassador_pending", where: raw("((ambassador_public_code IS NOT NULL) AND (ambassador_notified_at IS NULL))"))
}

/// Web Push subscriptions del cliente de storefront (seguimiento sin login).
/// El orderId es el secreto; varias subscriptions por pedido (multi-device).
model storefront_order_push_subscription {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
