/// Cuenta de consumo de salón (POS, Fase 2 de `docs/arquitectura/POS_TECHNICAL_DESIGN.md §4.A/§4.B`).
/// Agrupa N rondas (`orders`, vínculo `orders.table_tab_id` llega en Fase 3) y N asignaciones de mesa
/// (`table_tab_table`, N:N). El estado de ocupación de una mesa es siempre DERIVADO de la existencia de
/// una fila activa en `table_tab_table` cuya `table_tab` esté `open` — nunca un campo propio de `table`.
model table_tab {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id       String          @db.Uuid
  status            TableTabStatus  @default(open)
  opened_at         DateTime        @default(now()) @db.Timestamptz(6)
  closed_at         DateTime?       @db.Timestamptz(6)
  /// Quién abrió la cuenta. Requerido por la aplicación en el momento de creación (no nullable en la
  /// práctica); nullable a nivel de columna solo para permitir `SetNull` si el `business_user` se borra,
  /// mismo patrón que `orders.assigned_delivery_user_id`.
  opened_by_user_id String?         @db.Uuid
  /// Mozo responsable actual. Por defecto, igual a `opened_by_user_id`; actualizable vía PATCH simple en
  /// cambio de turno (DECISIÓN APROBADA — MVP sin tabla de eventos de reasignación, ver §4.A).
  assigned_user_id  String?         @db.Uuid
  business          business        @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_table_tab_business")
  opened_by         business_user?  @relation("TableTabOpenedBy", fields: [opened_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assigned_to       business_user?  @relation("TableTabAssignedTo", fields: [assigned_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tables            table_tab_table[]
  orders            orders[]
  tab_payment       tab_payment[]
  billable_charge   billable_charge[]

  @@index([business_id], map: "idx_table_tab_business")
  @@index([business_id, status], map: "idx_table_tab_business_status")
}

enum TableTabStatus {
  open
  closed
  /// Reservado para cuando se implemente la fusión de cuentas (fuera del alcance de la Fase 2).
  merged
}

/// Asignación N:N cuenta↔mesa. Nunca se edita una fila existente para "mover" una mesa — se cierra
/// (`unassigned_at = now()`) y se abre una nueva, preservando el historial de qué mesa ocupó la cuenta
/// en cada momento (DECISIÓN APROBADA — "mesa actual", sin explotar este historial en reportes del MVP).
/// La unicidad de la asignación ACTIVA por mesa (a lo sumo una fila con `unassigned_at IS NULL` por
/// `table_id`) se garantiza con un índice único parcial creado por migración SQL manual (no expresable
/// en el DSL declarativo de Prisma) — ver `prisma/migrations/*_table_tab_active_assignment_unique`.
model table_tab_table {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  table_tab_id  String    @db.Uuid
  table_id      String    @db.Uuid
  assigned_at   DateTime  @default(now()) @db.Timestamptz(6)
  unassigned_at DateTime? @db.Timestamptz(6)
  table_tab     table_tab @relation(fields: [table_tab_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_table_tab_table_tab")
  table         table     @relation(fields: [table_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_table_tab_table_table")

  @@index([table_tab_id], map: "idx_table_tab_table_tab")
  @@index([table_id], map: "idx_table_tab_table_table")
}

/// Estación de preparación (cocina, barra, etc.) — Fase 4 de POS_TECHNICAL_DESIGN.md.
/// Ruteo de comandas: cada `menu_item` apunta a una única estación (`menu_item_station`).
model preparation_station {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id       String              @db.Uuid
  name              String
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  business          business            @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_preparation_station_business")
  menu_item_station menu_item_station[]
  kitchen_ticket    kitchen_ticket[]

  @@index([business_id], map: "idx_preparation_station_business")
}

/// Ruteo simple: 1 estación por `menu_item` (no N:N). `menu_item_id` es único para
/// garantizar ese invariante a nivel de base de datos, no solo de aplicación.
model menu_item_station {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menu_item_id String            @unique @db.Uuid
  station_id String              @db.Uuid
  menu_item  menu_item           @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_menu_item_station_menu_item")
  station    preparation_station @relation(fields: [station_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_menu_item_station_station")

  @@index([station_id], map: "idx_menu_item_station_station")
}

/// Comanda por orden × estación: una orden multi-estación (p. ej. cocina + barra)
/// genera UN `kitchen_ticket` por cada estación involucrada. `@@unique([order_id,
/// station_id])` es la clave de idempotencia (Fase 4, POS_TECHNICAL_DESIGN.md) — un
/// reintento de generación de comandas sobre la misma orden nunca duplica el ticket
/// de una estación, hace upsert sobre esta fila.
model kitchen_ticket {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String               @db.Uuid
  station_id String               @db.Uuid
  created_at DateTime             @default(now()) @db.Timestamptz(6)
  order      orders               @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_kitchen_ticket_order")
  station    preparation_station  @relation(fields: [station_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_kitchen_ticket_station")
  kitchen_ticket_item kitchen_ticket_item[]

  @@unique([order_id, station_id], map: "unique_kitchen_ticket_order_station")
  @@index([station_id], map: "idx_kitchen_ticket_station")
}

/// Línea de comanda: 1:1 con el `order_item` que le dio origen (el ruteo de
/// `menu_item_station` decide a qué `kitchen_ticket` pertenece). El estado de esta fila
/// (`KitchenTicketItemStatus`) es puramente operativo de cocina — NUNCA muta
/// `orders.status` (`OrderStatus`) directamente; son máquinas de estado separadas
/// (ver POS_TECHNICAL_DESIGN.md §4.B / Fase 4).
model kitchen_ticket_item {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kitchen_ticket_id String                  @db.Uuid
  order_item_id     String                  @unique @db.Uuid
  status            KitchenTicketItemStatus @default(pending)
  created_at        DateTime                @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  kitchen_ticket       kitchen_ticket             @relation(fields: [kitchen_ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_kitchen_ticket_item_ticket")
  order_item           order_item                 @relation(fields: [order_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_kitchen_ticket_item_order_item")
  kitchen_ticket_item_event kitchen_ticket_item_event[]

  @@index([kitchen_ticket_id], map: "idx_kitchen_ticket_item_ticket")
}

/// Historial de transiciones de `kitchen_ticket_item.status`. Append-only: cada cambio
/// de estado agrega una fila, nunca se edita/borra una existente (mismo principio
/// snapshot/append-only que el resto del ledger económico del sistema).
model kitchen_ticket_item_event {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kitchen_ticket_item_id String             @db.Uuid
  from_status           KitchenTicketItemStatus?
  to_status             KitchenTicketItemStatus
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  created_by_user_id    String?             @db.Uuid
  kitchen_ticket_item   kitchen_ticket_item @relation(fields: [kitchen_ticket_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_kitchen_ticket_item_event_item")
  order_item_adjustment order_item_adjustment[]

  @@index([kitchen_ticket_item_id], map: "idx_kitchen_ticket_item_event_item")
}

enum KitchenTicketItemStatus {
  pending
  preparing
  ready
  /// Ítem cancelado desde cocina (p. ej. sin stock) — separado de `OrderStatus.cancelled`,
  /// que es una decisión comercial distinta.
  canceled
}

/// Motivo estructurado de anulación, exigido cuando el `kitchen_ticket_item` ya
/// estaba `preparing`/`ready` al momento de anular (POS_TECHNICAL_DESIGN.md §4.C,
/// "DECISIÓN APROBADA — anulación de productos y su impacto económico").
enum OrderItemAdjustmentReason {
  OUT_OF_STOCK
  CUSTOMER_REQUEST
  KITCHEN_ERROR
  OTHER
}

/// Anulación compensatoria de un `order_item` ya confirmado (Fase 4,
/// POS_TECHNICAL_DESIGN.md §4.C). Nunca edita/borra `order_item` — es una fila
/// nueva, igual que los reversos de `tab_payment` (§5): el saldo de la cuenta se
/// recalcula por agregación (`Σ order_item` + `Σ order_item_adjustment.amount`,
/// este último siempre ≤ 0), nunca mutando un campo cacheado.
///
/// `kitchen_ticket_item_event_id` referencia el evento que registró el estado del
/// `kitchen_ticket_item` en el momento exacto de la anulación (compare-and-swap
/// dentro de la misma transacción) — reconcilia por construcción el ledger de
/// ajustes con el de cocina, sin depender de sincronización manual posterior.
model order_item_adjustment {
  id                            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_item_id                 String                     @db.Uuid
  /// Siempre ≤ 0 por ahora: el único tipo de ajuste implementado es la anulación.
  amount                         Decimal                    @db.Decimal(12, 2)
  /// Obligatorio si el ítem ya estaba `preparing`/`ready` al anular; null si estaba `pending`.
  reason                         OrderItemAdjustmentReason?
  requested_by_user_id           String?                    @db.Uuid
  kitchen_ticket_item_event_id   String?                    @db.Uuid
  created_at                     DateTime                   @default(now()) @db.Timestamptz(6)
  order_item                     order_item                 @relation(fields: [order_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_order_item_adjustment_order_item")
  requested_by                   business_user?             @relation("OrderItemAdjustmentRequestedBy", fields: [requested_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  kitchen_ticket_item_event      kitchen_ticket_item_event? @relation(fields: [kitchen_ticket_item_event_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([order_item_id], map: "idx_order_item_adjustment_order_item")
}

/// Fase 6 (POS_TECHNICAL_DESIGN.md §4.D): el ledger de pagos de una cuenta de
/// salón. `pending` existe para integraciones de pago asíncronas futuras (hoy
/// ningún código de este repo crea una fila en `pending` — el registro de pago
/// de Fase 6 es siempre efectivo/síncrono y confirma de inmediato — pero el
/// bloqueo duro de cierre que exige "ningún pago pending" debe ser correcto
/// desde el modelo de datos, no agregarse recién cuando exista esa integración).
enum TabPaymentStatus {
  pending
  confirmed
  /// Reverso: fila nueva con `reversal_of_id` apuntando al original y montos
  /// de signo contrario — nunca se edita/borra una fila `confirmed` (§5).
  reversed
}

/// `amount_tendered` es lo que efectivamente entró; `amount_applied` (≤
/// `amount_tendered`) es lo aplicado a deuda real de la cuenta — la diferencia
/// es vuelto, calculado y nunca persistido como crédito (DECISIÓN APROBADA —
/// vuelto dinámico, sin saldo a favor, §4.D). `idempotency_key` deja la puerta
/// abierta a reintentos seguros desde el cliente (nullable: el único
/// mecanismo de registro hoy es sincrónico desde el panel, no todos los
/// llamadores necesitan una clave). El reparto entre órdenes vive en
/// `tab_payment_application`, nunca en un campo de este modelo.
model tab_payment {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id        String                    @db.Uuid
  table_tab_id       String                    @db.Uuid
  amount_tendered    Decimal                   @db.Decimal(12, 2)
  amount_applied     Decimal                   @db.Decimal(12, 2)
  status             TabPaymentStatus          @default(confirmed)
  reversal_of_id     String?                   @db.Uuid
  /// Único por negocio cuando no es null — índice único parcial creado por
  /// migración SQL manual (no expresable en el DSL declarativo de Prisma),
  /// mismo patrón ya usado por `table_tab_table`.
  idempotency_key    String?
  created_by_user_id String?                   @db.Uuid
  created_at         DateTime                  @default(now()) @db.Timestamptz(6)
  business           business                  @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tab_payment_business")
  table_tab          table_tab                 @relation(fields: [table_tab_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tab_payment_table_tab")
  reversal_of        tab_payment?              @relation("TabPaymentReversal", fields: [reversal_of_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reversals          tab_payment[]             @relation("TabPaymentReversal")
  created_by         business_user?            @relation("TabPaymentCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  applications       tab_payment_application[]

  @@index([table_tab_id], map: "idx_tab_payment_table_tab")
  @@index([business_id, status], map: "idx_tab_payment_business_status")
}

/// Reparto de un `tab_payment` entre las órdenes/rondas con saldo pendiente de
/// la cuenta (FIFO por defecto, o asignación explícita del cajero — ambas
/// decisiones ya aprobadas, §4.D). El saldo de cada orden, y de la cuenta, se
/// calcula siempre por agregación sobre esta tabla — nunca un campo cacheado.
model tab_payment_application {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tab_payment_id String      @db.Uuid
  order_id       String      @db.Uuid
  amount         Decimal     @db.Decimal(12, 2)
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  tab_payment    tab_payment @relation(fields: [tab_payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tab_payment_application_payment")
  order          orders      @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tab_payment_application_order")

  @@index([tab_payment_id], map: "idx_tab_payment_application_payment")
  @@index([order_id], map: "idx_tab_payment_application_order")
}

enum BillableChargeStatus {
  /// Pendiente de emisión fiscal — bloquea duro el cierre de la cuenta (§4.B/§4.E).
  open
  /// Ya tiene un `fiscal_invoice` emitido — deja de bloquear el cierre.
  issued
}

/// Fase 7 (POS_TECHNICAL_DESIGN.md §4.E): entidad intermedia entre `table_tab`
/// y `fiscal_invoice` — snapshot de qué líneas (de una o varias rondas) se
/// facturan juntas y por qué monto, equivalente para facturación de lo que
/// `payment_intent` es para pago (una intención con snapshot, no el resultado).
model billable_charge {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id    String                   @db.Uuid
  table_tab_id   String                   @db.Uuid
  amount         Decimal                  @db.Decimal(12, 2)
  status         BillableChargeStatus     @default(open)
  created_at     DateTime                 @default(now()) @db.Timestamptz(6)
  business       business                 @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_billable_charge_business")
  table_tab      table_tab                @relation(fields: [table_tab_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_billable_charge_table_tab")
  lines          billable_charge_line[]
  fiscal_invoice fiscal_invoice[]

  @@index([table_tab_id], map: "idx_billable_charge_table_tab")
  @@index([business_id, status], map: "idx_billable_charge_business_status")
}

/// Cuánto de cada `order_item` ya fue facturado — consultada siempre por suma,
/// nunca cacheada de forma mutable (DECISIÓN APROBADA, §4.E). Un `billable_charge`
/// nuevo sobre una orden ya parcialmente facturada solo puede tomar la cantidad
/// remanente (`order_item.quantity − Σ quantity_billed` ya confirmada) — esto
/// es lo que previene la doble facturación parcial a nivel de aplicación.
model billable_charge_line {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billable_charge_id String          @db.Uuid
  order_item_id      String          @db.Uuid
  quantity_billed    Int
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  billable_charge    billable_charge @relation(fields: [billable_charge_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_billable_charge_line_charge")
  order_item         order_item      @relation(fields: [order_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_billable_charge_line_order_item")

  @@index([billable_charge_id], map: "idx_billable_charge_line_charge")
  @@index([order_item_id], map: "idx_billable_charge_line_order_item")
}

