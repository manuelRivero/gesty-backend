/// Comprobante de transferencia bancaria mandado por el cliente vía WhatsApp.
/// El admin lo revisa desde el panel y aprueba o rechaza; `status` es propio
/// de esta tabla, no del enum OrderPaymentStatus (ver ADR-0005/0006).
model payment_proof {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id     String        @db.Uuid
  order_id        String        @db.Uuid
  customer_id     String        @db.Uuid
  conversation_id String?       @db.Uuid
  media_key       String
  media_url       String
  media_mime      String
  media_sha256    String?
  /// Hash perceptual (8x8 grises); índice normal, no único (ver D6 del plan).
  perceptual_hash String?
  /// received | auto_checked | approved | rejected
  status          String        @default("received")
  extracted       Json?
  checks          Json?
  reviewed_by     String?       @db.Uuid
  reviewed_at     DateTime?     @db.Timestamptz(6)
  review_note     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  business        business      @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversation    conversation? @relation(fields: [conversation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer        customer      @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders          orders        @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([business_id, order_id], map: "idx_payment_proof_business_order")
  @@index([business_id, status], map: "idx_payment_proof_business_status")
  @@index([business_id, perceptual_hash], map: "idx_payment_proof_business_perceptual_hash")
}

/// Flujo operativo del pedido (logística). No indica si ya se cobró — ver `payment_status`.
enum OrderStatus {
  draft
  /// Pedido confirmado (en cola / listo para preparar). Antes `pending_payment`.
  placed
  preparing
  shipped
  /// Pedido listo para ser retirado por el cliente (solo take-away).
  ready_for_pickup
  delivered
  cancelled
}

/// Tipo de entrega del pedido.
enum FulfillmentType {
  DELIVERY
  TAKE_AWAY
}

/// Cobro: independiente del flujo operativo (logística). Solo dos valores: pendiente vs cobrado.
enum OrderPaymentStatus {
  /// Aún no cobrado (link, efectivo al entregar, etc.).
  unpaid
  /// Cobro registrado (pasarela, caja, etc.).
  paid
}

/// Rol de la categoría para complementos (entrada vs plato fuerte, bebida, etc.). OTHER = sin clasificar.
enum MenuCategoryTag {
  STARTER
  MAIN
  SIDE
  DRINK
  DESSERT
  OTHER
}
