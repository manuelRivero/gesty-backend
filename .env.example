# Servidor
PORT=5001
PUBLIC_URL=http://localhost:5001
CORS_ORIGIN=http://localhost:3000

# Postgres (compartida con food-service-backend)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEST_TO=

# OpenAI
OPENAI_API_KEY=

# Modo del agente: deterministic (paridad 1:1 con backend viejo) | hybrid (ReAct
# con tools LangChain para ORDER_FOOD / PRODUCT_QUERY / PRODUCT_ATTRIBUTE_QUESTION /
# UNKNOWN — el resto sigue ruteando por handlers determinísticos).
AGENT_MODE=deterministic

# Si está en true/1, sendResponseNode y persistAIMessageNode no envían a Meta ni
# persisten el AIMessage. Pensado para los runners de paridad.
DRY_RUN_WHATSAPP_SEND=false
