# =============================================================================
# Plantilla de entorno — food-service-agent (producción en VPS)
# =============================================================================
# Copiá este archivo a `.env` EN EL SERVIDOR (/opt/apps/food-service-agent/.env).
# NUNCA commitees `.env` con secretos. La imagen Docker NO incluye este archivo.
#
# Clasificación completa: ver tabla en DEPLOY.md
# =============================================================================

# --- Deploy (solo docker-compose.prod.yml; la app NO las lee) ---
# Imagen publicada en Docker Hub
DOCKER_IMAGE=manuelrivero/food-service-agent:latest
# Subdominio configurado en Nginx Proxy Manager (referencia operativa)
DOMAIN=api.tu-dominio.com

# --- Servidor HTTP ---
PORT=5001
NODE_ENV=production
# URL pública HTTPS (QR de reservas, enlaces absolutos)
PUBLIC_URL=https://api.tu-dominio.com
# Orígenes CORS permitidos, separados por coma (frontend admin + Socket.IO)
CORS_ORIGIN=https://tu-frontend.com

# --- Base de datos (Postgres / Neon) ---
# El esquema lo gestiona food-service-backend; esta app NO ejecuta migraciones al arrancar.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Worker cada 60s (drafts + cierre idle). OFF por defecto: cada tick pega a Neon.
# Solo activar cuando haya estrategia de costos / menos frecuencia.
ENABLE_DRAFT_ORDER_WORKER=false

# --- OpenAI (requerido) ---
OPENAI_API_KEY=sk-xxxxx

# --- Modo del agente ---
# deterministic | hybrid
AGENT_MODE=hybrid
# true/1 = no envía a WhatsApp ni persiste AIMessage (solo para tests locales)
DRY_RUN_WHATSAPP_SEND=false

# --- CTA híbrido post-ReAct (opcional) ---
HYBRID_CTA_ENABLED=false
HYBRID_CTA_TARGET_INTENTS=PRODUCT_ATTRIBUTE_QUESTION,PRODUCT_QUERY
# Vacío = habilitado para todos los negocios cuando HYBRID_CTA_ENABLED=true
HYBRID_CTA_ENABLED_BUSINESS_IDS=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
WHATSAPP_VERIFY_TOKEN=
# Solo desarrollo / pruebas manuales
WHATSAPP_TEST_TO=

# --- Auth JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=4h
JWT_REFRESH_EXPIRES=8h
# Alternativa a JWT_REFRESH_EXPIRES (milisegundos); tiene prioridad si está definido
# JWT_REFRESH_EXPIRES_MS=28800000

# --- Cookies de sesión (panel admin) ---
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_ACCESS_COOKIE_MAX_AGE=14400
AUTH_REFRESH_COOKIE_MAX_AGE=28800
# lax | strict | none
AUTH_COOKIE_SAMESITE=lax
# En producción detrás de HTTPS suele activarse automáticamente si NODE_ENV=production
AUTH_COOKIE_SECURE=true
# Dominio compartido entre API y frontend (ej. .tu-dominio.com); vacío = host-only
AUTH_COOKIE_DOMAIN=

# --- Pagos (Mercado Pago) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_PROVIDER_ENCRYPTION_KEY=
MERCADO_PAGO_WEBHOOK_BASE_URL=https://api.tu-dominio.com

# --- Object storage (Cloudflare R2, API S3-compatible) ---
# Account ID del dashboard Cloudflare (32 hex). Endpoint:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Si el TLS falla, verificá el Account ID o usá R2_ENDPOINT explícito.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# URL pública (r2.dev o custom domain). NO uses el endpoint S3 API.
R2_PUBLIC_URL=https://cdn.tu-dominio.com
# Opcional: override del endpoint S3 (ej. jurisdicción EU)
# R2_ENDPOINT=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com

ONBOARDING_AGENT_ENABLED=true