# ====== Plantilla de entorno para producción ======
# Copiá este archivo a `.env` EN EL SERVIDOR y completá con valores reales.
# NUNCA commitees el .env con secretos. La imagen NO incluye este archivo.

# --- Servidor ---
PORT=5001
# Dominio público (HTTPS) detrás del reverse proxy.
PUBLIC_URL=https://tu-dominio.com
# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGIN=https://tu-frontend.com

# --- Modo del agente: deterministic | hybrid ---
AGENT_MODE=hybrid
DRY_RUN_WHATSAPP_SEND=false

# --- Base de datos (Postgres / Neon) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxx

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEST_TO=

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Pagos ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_PROVIDER_ENCRYPTION_KEY=
MERCADO_PAGO_WEBHOOK_BASE_URL=https://tu-dominio.com
