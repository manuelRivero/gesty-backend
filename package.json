{
  "name": "food-service-agent",
  "version": "0.1.0",
  "main": "dist/index.js",
  "description": "Agente conversacional WhatsApp basado en LangGraph + LangChain. Reimplementa el orquestador del bot de food-service-backend como un grafo de nodos.",
  "scripts": {
    "build": "tsc",
    "build:prod": "tsc -p tsconfig.build.json",
    "obfuscate": "node scripts/obfuscate.mjs",
    "build:obf": "npm run build:prod && npm run obfuscate",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node -r dotenv/config src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:sync": "cp ../food-service-backend/prisma/schema.prisma ./prisma/schema.prisma",
    "parity:run": "ts-node --project scripts/parity/tsconfig.json -r dotenv/config scripts/parity/runner.ts",
    "embed:seed": "ts-node -r dotenv/config scripts/embedding/create-menu_item-vector.ts",
    "seed:reservation-slots": "ts-node -r dotenv/config scripts/reservation/seed-reservation-slots.ts",
    "seed:bot-personality-samples": "ts-node -r dotenv/config scripts/seed-bot-personality-samples.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "E2E_RUN=1 vitest run -c vitest.e2e.config.ts",
    "test:party-checkout-flow": "E2E_RUN=1 vitest run -c vitest.e2e.config.ts e2e/party-checkout-flow.e2e.test.ts",
    "test:checkout-flow": "E2E_RUN=1 vitest run -c vitest.e2e.config.ts e2e/checkout-flow.e2e.test.ts",
    "test:last-offer": "E2E_RUN=1 vitest run -c vitest.e2e.config.ts e2e/last-offer-add-item.e2e.test.ts",
    "test:agent-history": "E2E_RUN=1 vitest run -c vitest.e2e.config.ts e2e/agent-history.e2e.test.ts",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@langchain/core": "^0.3.66",
    "@langchain/langgraph": "^0.4.9",
    "@langchain/openai": "^0.6.14",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "cookie": "^1.1.1",
    "cors": "^2.8.6",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^0.3.36",
    "mercadopago": "^3.1.0",
    "openai": "^6.22.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.5",
    "javascript-obfuscator": "^5.4.3",
    "nodemon": "^3.1.11",
    "prisma": "^7.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
