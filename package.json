{
  "name": "food-service-agent",
  "version": "0.1.0",
  "main": "dist/index.js",
  "description": "Agente conversacional WhatsApp basado en LangGraph + LangChain. Reimplementa el orquestador del bot de food-service-backend como un grafo de nodos.",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node -r dotenv/config src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:sync": "cp ../food-service-backend/prisma/schema.prisma ./prisma/schema.prisma",
    "parity:run": "ts-node --project scripts/parity/tsconfig.json -r dotenv/config scripts/parity/runner.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@langchain/core": "^0.3.66",
    "@langchain/langgraph": "^0.4.9",
    "@langchain/openai": "^0.6.14",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "axios": "^1.13.5",
    "cors": "^2.8.6",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "langchain": "^0.3.36",
    "openai": "^6.22.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.5",
    "nodemon": "^3.1.11",
    "prisma": "^7.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
